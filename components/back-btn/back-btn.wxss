.back-btn {
  position: fixed;
  left: 24rpx;
  z-index: 1000;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(253, 250, 245, 0.88);
  box-shadow: 0 4rpx 16rpx rgba(74, 69, 64, 0.1);
  backdrop-filter: blur(8px);
  transition: transform 0.45s cubic-bezier(0.34, 1.2, 0.64, 1);
}

.back-btn-hover {
  transform: scale(0.92);
}

.back-btn.theme-light {
  background: rgba(255, 255, 255, 0.15);
  box-shadow: none;
}

.arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--color-ink, #4A4540);
  border-bottom: 4rpx solid var(--color-ink, #4A4540);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.theme-light .arrow {
  border-color: rgba(255, 255, 255, 0.85);
}

.back-btn-cover {
  position: fixed;
  left: 12px;
  z-index: 10000;
  width: 32px;
  height: 32px;
  line-height: 28px;
  border-radius: 16px;
  background-color: rgba(253, 250, 245, 0.92);
  color: #4A4540;
  font-size: 22px;
  text-align: center;
  padding-left: 2px;
  box-sizing: border-box;
}
