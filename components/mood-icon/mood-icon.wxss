.mood-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
}

.mood-wrap.highlight {
  background: var(--color-kraft);
  transform: scale(1.08);
  box-shadow: 0 4rpx 16rpx var(--color-shadow);
}

.mood-canvas {
  display: block;
}
