.nav-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(253, 250, 245, 0.92);
  border-radius: 999rpx;
  margin: 0 32rpx;
  box-shadow: 0 4rpx 24rpx var(--color-shadow);
  backdrop-filter: blur(8px);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid var(--color-ink);
  border-radius: 50%;
  position: relative;
  margin-bottom: 4rpx;
}

.icon-settings::after {
  content: '';
  position: absolute;
  width: 12rpx; height: 12rpx;
  border: 3rpx solid var(--color-ink);
  border-radius: 50%;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}

.icon-notes {
  border-radius: 8rpx;
  border-width: 3rpx;
}
.icon-notes::before, .icon-notes::after {
  content: '';
  position: absolute;
  left: 10rpx; right: 10rpx;
  height: 3rpx;
  background: var(--color-ink);
  border-radius: 2rpx;
}
.icon-notes::before { top: 14rpx; }
.icon-notes::after { top: 26rpx; width: 60%; }

.icon-stats::before {
  content: '';
  position: absolute;
  bottom: 8rpx; left: 8rpx;
  width: 8rpx; height: 16rpx;
  background: var(--color-tea);
  border-radius: 4rpx 4rpx 0 0;
  box-shadow: 12rpx -8rpx 0 var(--color-pink), 24rpx -4rpx 0 var(--color-mist);
}

.icon-games::before {
  content: '♪';
  position: absolute;
  font-size: 24rpx;
  top: 50%; left: 50%;
  transform: translate(-50%, -55%);
  color: var(--color-ink);
}

.nav-label {
  font-size: 20rpx;
  color: var(--color-ink-light);
  letter-spacing: 1rpx;
}

.settings-mask {
  position: fixed;
  inset: 0;
  background: rgba(74, 69, 64, 0.25);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
}

.settings-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.settings-panel {
  width: 100%;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  transform: translateY(100%);
  transition: transform 0.45s cubic-bezier(0.34, 1.2, 0.64, 1);
}

.settings-mask.show .settings-panel {
  transform: translateY(0);
}

.settings-title {
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
}

.setting-row {
  margin: 28rpx 0;
}
.setting-row.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-label {
  font-size: 28rpx;
  color: var(--color-ink-light);
  display: block;
  margin-bottom: 16rpx;
}

.option-group {
  display: flex;
  gap: 16rpx;
}

.option-chip {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  border: 2rpx dashed var(--color-tea-light);
  font-size: 26rpx;
  color: var(--color-ink-light);
}

.option-chip.active {
  background: var(--color-kraft);
  border-style: solid;
  border-color: var(--color-tea);
  color: var(--color-ink);
}

.setting-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-kraft);
  font-size: 28rpx;
}

.action-btn.danger {
  background: rgba(212, 165, 165, 0.3);
  color: #8B5A5A;
}
