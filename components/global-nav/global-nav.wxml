<view class="nav-bar">
  <view class="nav-item tap-soft" bindtap="onSettings">
    <view class="nav-icon icon-settings"></view>
    <text class="nav-label">设置</text>
  </view>
  <view class="nav-item tap-soft" bindtap="onNotes">
    <view class="nav-icon icon-notes"></view>
    <text class="nav-label">日记</text>
  </view>
  <view class="nav-item tap-soft" bindtap="onStats">
    <view class="nav-icon icon-stats"></view>
    <text class="nav-label">统计</text>
  </view>
  <view class="nav-item tap-soft" bindtap="onGames">
    <view class="nav-icon icon-games"></view>
    <text class="nav-label">解压</text>
  </view>
</view>

<!-- 设置弹窗 -->
<view class="settings-mask {{showSettings ? 'show' : ''}}" bindtap="closeSettings">
  <view class="settings-panel notebook-card animate-in" catchtap="noop">
    <text class="settings-title">个性化设置</text>
    <view class="dashed-divider"></view>

    <view class="setting-row">
      <text class="setting-label">背景色调</text>
      <view class="option-group">
        <view wx:for="{{themes}}" wx:key="id"
          class="option-chip tap-soft {{settings.bgTone === item.id ? 'active' : ''}}"
          data-id="{{item.id}}" bindtap="setTheme">{{item.label}}</view>
      </view>
    </view>

    <view class="setting-row">
      <text class="setting-label">字体大小</text>
      <view class="option-group">
        <view wx:for="{{fontSizes}}" wx:key="id"
          class="option-chip tap-soft {{settings.fontSize === item.id ? 'active' : ''}}"
          data-id="{{item.id}}" bindtap="setFontSize">{{item.label}}</view>
      </view>
    </view>

    <view class="setting-row between">
      <text class="setting-label">轻柔音效</text>
      <switch checked="{{settings.soundEnabled}}" bindchange="toggleSound" color="#C4A882"/>
    </view>

    <view class="dashed-divider"></view>

    <view class="setting-actions">
      <view class="action-btn tap-soft" bindtap="exportData">导出数据</view>
      <view class="action-btn danger tap-soft" bindtap="clearData">清空数据</view>
    </view>
  </view>
</view>
