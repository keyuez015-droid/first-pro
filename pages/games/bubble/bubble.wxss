.bubble-page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.top-overlay-cover {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9998;
  text-align: center;
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}

.score-cover {
  color: rgba(255, 255, 255, 0.9);
  font-size: 14px;
  letter-spacing: 1px;
}

.hint-cover {
  position: fixed;
  bottom: 40px;
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 11px;
  z-index: 9998;
}

.bubble-canvas {
  width: 100vw;
  height: 100vh;
  display: block;
}

.feedback {
  position: absolute;
  color: #F0D5A8;
  font-size: 28rpx;
  font-weight: 600;
  pointer-events: none;
  transform: translate(-50%, -100%);
  z-index: 20;
}

.encourage {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(253,250,245,0.85);
  padding: 24rpx 48rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  color: var(--color-ink);
  z-index: 20;
  letter-spacing: 4rpx;
}
