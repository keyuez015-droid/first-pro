.bubble-page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.top-overlay {
  position: absolute;
  top: 0; left: 0; right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
}

.score {
  flex: 1;
  text-align: center;
  color: rgba(255,255,255,0.9);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.bubble-canvas {
  width: 100vw;
  height: 100vh;
  display: block;
}

.feedback {
  position: absolute;
  color: #F0D5A8;
  font-size: 28rpx;
  font-weight: 600;
  pointer-events: none;
  transform: translate(-50%, -100%);
  z-index: 20;
}

.encourage {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(253,250,245,0.85);
  padding: 24rpx 48rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  color: var(--color-ink);
  z-index: 20;
  letter-spacing: 4rpx;
}

.hint {
  position: absolute;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 0; right: 0;
  text-align: center;
  color: rgba(255,255,255,0.5);
  font-size: 22rpx;
  z-index: 10;
}
