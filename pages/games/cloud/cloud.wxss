.page { width: 100vw; height: 100vh; position: relative; }
.top-overlay {
  position: absolute; top: 0; left: 0; right: 0; z-index: 10;
  display: flex; align-items: center; padding: 16rpx 32rpx;
}
.back { font-size: 48rpx; color: var(--color-ink-light); width: 60rpx; }
.title { flex: 1; text-align: center; font-size: 28rpx; letter-spacing: 4rpx; color: var(--color-ink-light); }
.full-canvas { width: 100vw; height: 100vh; display: block; }
.hint {
  position: absolute; bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 0; right: 0; text-align: center;
  font-size: 22rpx; color: var(--color-ink-light); opacity: 0.6;
}
