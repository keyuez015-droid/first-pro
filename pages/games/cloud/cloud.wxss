.page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.top-overlay-cover {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9998;
  text-align: center;
  padding: 16rpx 32rpx 16rpx 80rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.title-cover {
  font-size: 14px;
  letter-spacing: 2px;
  color: #8A8278;
}

.hint-cover {
  position: fixed;
  bottom: calc(40px + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  text-align: center;
  font-size: 11px;
  color: #8A8278;
  opacity: 0.6;
  z-index: 9998;
  pointer-events: none;
}
