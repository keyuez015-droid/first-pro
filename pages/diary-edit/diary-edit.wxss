.page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.top-bar {
  background: linear-gradient(180deg, #F5EDD8 0%, transparent 100%);
}

.top-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 24rpx;
}

.spacer { width: 60rpx; }

.date-label {
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.submit-btn {
  background: var(--color-ink);
  color: var(--color-paper);
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.edit-card {
  margin: 16rpx 32rpx;
  padding: 40rpx 32rpx 40rpx 48rpx;
  min-height: 500rpx;
}

.paper-area {
  position: relative;
  min-height: 400rpx;
}

.paper-input {
  width: 100%;
  min-height: 360rpx;
  font-size: 30rpx;
  line-height: 56rpx;
  color: var(--color-ink);
  font-weight: 300;
  position: relative;
  z-index: 2;
  background: transparent;
}

.placeholder {
  color: var(--color-tea-light);
  font-weight: 300;
}

.paper-lines {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(
    transparent, transparent 54rpx,
    rgba(196,168,130,0.25) 54rpx, rgba(196,168,130,0.25) 56rpx
  );
  pointer-events: none;
  z-index: 1;
}

.cat-deco {
  position: absolute;
  right: 0;
  bottom: -20rpx;
  width: 120rpx;
  height: 100rpx;
  z-index: 3;
}

.cat-body {
  width: 80rpx;
  height: 60rpx;
  background: var(--color-kraft);
  border: 3rpx solid var(--color-ink);
  border-radius: 50% 50% 40% 40%;
  position: absolute;
  bottom: 0;
  right: 20rpx;
}

.cat-ear {
  width: 24rpx;
  height: 32rpx;
  border: 3rpx solid var(--color-ink);
  background: var(--color-kraft);
  position: absolute;
  bottom: 48rpx;
}
.cat-ear.left { right: 68rpx; border-radius: 8rpx 8rpx 0 0; transform: rotate(-15deg); }
.cat-ear.right { right: 36rpx; border-radius: 8rpx 8rpx 0 0; transform: rotate(15deg); }

.cat-tail {
  width: 40rpx;
  height: 3rpx;
  background: var(--color-ink);
  position: absolute;
  bottom: 20rpx;
  right: 0;
  border-radius: 2rpx;
  transform: rotate(-20deg);
}

.image-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
}

.add-image {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-tea);
  letter-spacing: 2rpx;
}

.mood-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(253,250,245,0.95);
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx var(--color-shadow);
  backdrop-filter: blur(8px);
}

.mood-scroll {
  white-space: nowrap;
}

.mood-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 8rpx;
}

.mood-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
}

.mood-label {
  font-size: 22rpx;
  color: var(--color-ink-light);
  margin-top: 4rpx;
}

.mood-label.active {
  color: var(--color-ink);
  font-weight: 500;
}
