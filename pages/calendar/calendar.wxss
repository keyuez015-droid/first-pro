.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.top-bar {
  background: linear-gradient(180deg, #F5EDD8 0%, transparent 100%);
}

.top-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx 24rpx;
  position: relative;
}

.top-title {
  font-size: 32rpx;
  letter-spacing: 4rpx;
  font-weight: 400;
}

.month-switch {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--color-ink-light);
}

.month-switch:first-child { left: 32rpx; }
.month-switch:last-child { right: 32rpx; }

.calendar-card {
  margin: 24rpx 32rpx;
  padding: 40rpx 32rpx 48rpx 48rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 32rpx;
  padding-right: 16rpx;
}

.card-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: var(--color-ink);
}

.week-row {
  display: flex;
  border-bottom: 2rpx solid var(--color-ink);
  padding-bottom: 12rpx;
  margin-bottom: 8rpx;
}

.week-cell {
  flex: 1;
  text-align: center;
}

.week-cn {
  font-size: 24rpx;
  display: block;
}

.week-en {
  font-size: 18rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.28%;
  min-height: 100rpx;
  border-bottom: 2rpx dashed rgba(196,168,130,0.35);
  padding: 8rpx 4rpx;
  position: relative;
  box-sizing: border-box;
}

.day-cell.other {
  opacity: 0.35;
}

.day-num {
  font-size: 18rpx;
  color: var(--color-ink-light);
  font-family: var(--font-serif);
}

.sticker {
  display: flex;
  justify-content: center;
  margin-top: 4rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-right: 16rpx;
}

.footer-left, .footer-right {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--color-mist);
  font-weight: 600;
}

.footer-line {
  flex: 1;
  margin: 0 16rpx;
}

.tiny-logo {
  display: block;
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  color: var(--color-ink);
  font-style: italic;
  opacity: 0.7;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}
