.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.top-bar {
  background: linear-gradient(180deg, #F5EDD8 0%, transparent 100%);
}

.top-inner {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 24rpx;
}

.back { font-size: 48rpx; color: var(--color-ink-light); width: 60rpx; }
.top-title { flex: 1; text-align: center; font-size: 32rpx; letter-spacing: 4rpx; }
.spacer { width: 60rpx; }

.filter-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 0 32rpx 16rpx;
}

.filter-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx dashed var(--color-tea-light);
  font-size: 24rpx;
  color: var(--color-ink-light);
}

.filter-chip.active {
  background: var(--color-kraft);
  border-style: solid;
  color: var(--color-ink);
}

.chart-card {
  margin: 16rpx 32rpx;
  padding: 32rpx 32rpx 32rpx 48rpx;
}

.chart-title {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--color-ink-light);
  display: block;
  margin-bottom: 16rpx;
}

.chart-canvas {
  width: 100%;
  display: block;
}

.chart-canvas.pie { height: 360rpx; }
.chart-canvas.bar { height: 400rpx; }
.chart-canvas.line { height: 280rpx; }

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-ink-light);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.trend-legend {
  display: flex;
  gap: 32rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
}

.trend-legend .pos { color: #A8C4BC; }
.trend-legend .neg { color: #D4A5A5; }
